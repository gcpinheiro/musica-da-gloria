{
  "name": "musica-da-gloria",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:demo": "ng serve --configuration demo --host 127.0.0.1 --port 4210",
    "demo:video": "node tools/demo/generate-video.mjs",
    "demo:validate": "node node_modules/@argo-video/cli/bin/argo.js validate musica-da-gloria --config tools/demo/argo.config.mjs",
    "serve:ssr:musica-da-gloria": "node dist/musica-da-gloria/server/server.mjs",
    "docker:build": "docker build -t musica-da-gloria:local .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.7",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.7",
    "@angular/cli": "^20.3.7",
    "@angular/compiler-cli": "^20.3.0",
    "@argo-video/cli": "^0.42.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "kokoro-js": "^1.2.1",
    "typescript": "~5.9.2"
  }
}
